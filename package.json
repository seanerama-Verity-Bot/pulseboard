{
  "name": "pulseboard",
  "version": "0.1.0",
  "private": true,
  "description": "A small team status board: teammates post short updates; the board shows the whole team at a glance.",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web",
    "e2e"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema apps/server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/server/prisma/schema.prisma",
    "build:shared": "npm run build --workspace @pulseboard/shared",
    "dev": "npm run db:generate && npm run db:migrate && concurrently --names server,web --prefix-colors blue,magenta \"npm run dev --workspace @pulseboard/server\" \"npm run dev --workspace @pulseboard/web\"",
    "build": "npm run build --workspace @pulseboard/shared && npm run build --workspace @pulseboard/web && npm run build --workspace @pulseboard/server",
    "lint": "eslint .",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @pulseboard/e2e",
    "start": "node apps/server/dist/index.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
