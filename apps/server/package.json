{
  "name": "@pulseboard/server",
  "version": "0.1.0",
  "private": true,
  "description": "Pulseboard Express + Prisma server; also serves the built SPA (ADR 0002).",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
