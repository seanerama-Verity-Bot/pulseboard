# Pulseboard — copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.

# One of: development | test | production. Optional, defaults to development.
NODE_ENV=development

# TCP port the Express server listens on (loopback only in production, ADR 0004).
# Optional, defaults to 3001.
PORT=3001

# Required. SQLite file URL. Relative paths are resolved by Prisma RELATIVE TO
# apps/server/prisma/ — see the "relative-path footgun" note in the README.
# Production (ADR 0004): file:/srv/pulseboard/data/pulseboard.db
DATABASE_URL="file:./dev.db"

# Required in production. The shared code teammates type to join (consumed from Stage 2).
TEAM_CODE=change-me-team-code

# Required in production, must be at least 32 characters, no fallback (ADR 0005).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-at-least-thirty-two-chars

# Optional, defaults to UTC. IANA zone name used for team-wide day boundaries (ADR 0008).
APP_TIMEZONE=UTC
